{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forum.rcmisfits.org/schemas/rcvenue-v1.json",
  "title": "RC venue template (rcvenue v1.3)",
  "type": "object",
  "required": ["format", "version", "id", "revision", "info", "area"],
  "properties": {
    "format": { "const": "rcvenue" },
    "version": { "const": 1 },
    "id": { "type": "string" },
    "revision": { "type": "integer", "minimum": 1 },
    "info": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "maxLength": 80 },
        "venue": {
          "type": ["object", "null"],
          "description": "The forum venue and the one track there that this template is for. trackId is missing on templates saved before rcvenue 1.1.",
          "required": ["id"],
          "properties": {
            "id": { "type": "integer" },
            "name": { "type": "string" },
            "trackId": { "type": "integer" },
            "trackName": { "type": "string" }
          }
        },
        "notes": { "type": "string" }
      }
    },
    "surface": {
      "enum": ["carpet", "astro", "grass", "dirt", "clay", "tarmac", "mixed"],
      "description": "rcvenue 1.2: what the track is laid on (1.3 adds grass). A template linked to a forum track is served with the forum track's surface; it isn't stored."
    },
    "area": {
      "type": "object",
      "description": "Usable track area in metres. Origin at its centre, +x east (right on the plan), +z north (up on the plan).",
      "required": ["length", "width"],
      "properties": {
        "length": { "type": "number", "exclusiveMinimum": 0 },
        "width": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "rostrum": {
      "type": "object",
      "properties": {
        "side": { "enum": ["north", "south", "east", "west"] },
        "offset": { "type": "number", "description": "Metres along that side from its centre" }
      }
    },
    "timingLoop": {
      "type": "object",
      "description": "rcvenue 1.2: the timing loop the start/finish line must sit over. x, z: its centre; heading: the direction of travel over it (degrees, 0 = +x, counter-clockwise); length: its span across the track (m).",
      "required": ["x", "z", "heading", "length"],
      "properties": {
        "x": { "type": "number" },
        "z": { "type": "number" },
        "heading": { "type": "number" },
        "length": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "obstacles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "x", "z"],
        "properties": {
          "type": { "enum": ["circle", "rect"] },
          "kind": { "enum": ["pits", "rostrum"], "description": "rcvenue 1.2: the pit area or the rostrum, a fixed zone; absent: an obstacle. All block a layout alike." },
          "x": { "type": "number" },
          "z": { "type": "number" },
          "radius": { "type": "number", "exclusiveMinimum": 0 },
          "length": { "type": "number", "exclusiveMinimum": 0 },
          "width": { "type": "number", "exclusiveMinimum": 0 },
          "rotation": { "type": "number" },
          "label": { "type": "string" }
        },
        "if": { "properties": { "type": { "const": "circle" } } },
        "then": { "required": ["radius"] },
        "else": { "required": ["length", "width"] }
      }
    }
  }
}
