# Track Studio server configuration. Copy to .env (git-ignored) and fill in.
# Relative paths are relative to the repo root.

# Port the server listens on (and the address: HOST, default 0.0.0.0)
PORT=3000
# HOST=0.0.0.0
# Public URL of this server, as browsers (and the forum) reach it — no trailing slash
BASE_URL=http://192.168.0.6:3000
# The Discourse forum that logs people in. Dev: http://discourse-dev.local:3000  Prod: https://forum.rcmisfits.org
FORUM_URL=http://discourse-dev.local:3000
# Must equal the forum's "discourse connect provider secrets" entry for this server's domain (min 10 chars)
DISCOURSE_CONNECT_SECRET=
# Signs session cookies. At least 32 characters: openssl rand -hex 32
SESSION_SECRET=
# SQLite file + preview PNG cache
DATA_DIR=./data
# Forum group whose members are organisers (forum admins always are)
ORGANISER_GROUP=track-admins
# Silent sign-in (#132): a first page visit checks the forum (prompt=none) and signs in members already signed in there. On by default.
# SILENT_SIGNIN=off

# ---- Production (docker-compose.prod.yml, docs/deploy.md) ----
# Domain Caddy gets the HTTPS certificate for (BASE_URL should be https://<this>)
# TRACKS_DOMAIN=tracks.rcmisfits.org
# Lets plain `docker compose` use the production file on the droplet
# COMPOSE_FILE=docker-compose.prod.yml

# Nightly backup to DigitalOcean Spaces (deploy/backup.sh). Create a Spaces access key limited to the backup bucket.
# Endpoint of the bucket's region, e.g. https://ams3.digitaloceanspaces.com
SPACES_ENDPOINT=
SPACES_BUCKET=
SPACES_KEY=
SPACES_SECRET=
# Signing region; defaults to the one in SPACES_ENDPOINT (ams3), else us-east-1
# SPACES_REGION=
# Folder in the bucket, and how many nightlies to keep
# BACKUP_PREFIX=track-studio/nightly
# BACKUP_KEEP=14

# Dev only: DEV_LOGIN=1 enables /auth/dev-login?user=<name>&organiser=1 (no forum needed; refused when NODE_ENV=production)
# DEV_LOGIN=1
# NODE_ENV=development
# LOG_LEVEL=info
